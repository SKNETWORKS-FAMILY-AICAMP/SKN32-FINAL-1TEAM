# 원버튼 배포 설정 (up.sh · down.sh 가 읽음)
#
# 어느 계정에서든 이 값 그대로 쓸 수 있다. 계정마다 다른 값(서버 이미지 번호, 가용영역,
# 내 공인 IP)은 스크립트가 실행할 때 알아서 찾는다.
# 내 PC 에서만 바꾸고 싶은 값은 같은 폴더의 settings.env.local 에 다시 적는다(커밋 안 됨).

# 스택 이름. 같은 계정에 한 벌 더 만들려면 다른 이름을 쓴다(영문으로 시작, 영문·숫자·-).
STACK_NAME=sbrain

# 리전. 서울 = ap-northeast-2
REGION=ap-northeast-2

# 서버 종류. 둘 다 x86(인텔·AMD) 종류여야 한다.
# 프리 플랜 계정은 c7i-flex.large(4GB) · m7i-flex.large(8GB) 같은 일부 종류만 쓸 수 있다.
WEB_INSTANCE_TYPE=c7i-flex.large
# 공고 서버는 BGE-M3 를 올려 순간 2.7GB 를 쓴다. 매일 배치까지 같이 돌리면 8GB 가 안전하다.
NOTICE_INSTANCE_TYPE=m7i-flex.large

# RDS
DB_INSTANCE_CLASS=db.t4g.micro
# MySQL 8.0 은 2026-07-31 표준 지원이 끝나 추가 요금(연장 지원)이 붙는다. 8.4 를 쓴다.
DB_ENGINE_VERSION=8.4
DB_STORAGE_GB=20
DB_NAME=s_brain

# 공고 서버의 고정 내부 주소. 웹 서버는 http://<이 주소>:8000 으로 부른다. 처음 만들 때만 반영된다.
NOTICE_PRIVATE_IP=10.20.11.10

# SSH(22번)를 허용할 주소. 비워 두면 지금 이 PC 의 공인 IP 하나(/32)만 연다.
# CloudShell 에서 실행할 때는 CloudShell 주소가 잡히므로 내 PC 주소를 직접 적는다. 예: 1.2.3.4/32
ADMIN_CIDR=

# S-Brain 공고 서버 — install-notice.sh 가 /etc/systemd/system/ 에 둔다. 서버에서 직접 고치지 않는다(다시 올리면 덮어쓴다).
# 워커가 부르는 네 창구(/api/collection_status · /api/match · /api/notices/{id} · .../eligibility)를 8000 번에서 연다.
# 리눅스에서는 search/app.py 가 스스로 0.0.0.0 에 연다. 보안 그룹이 웹 서버에서 오는 8000 번만 연다.
[Unit]
Description=S-Brain notice API (data-collection search.app, port 8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sbrain-notice
Group=sbrain-notice
UMask=0027
# MYSQL_* · MYSQL_SSL_CA(up.sh) 와 수집 키(deploy-notice.sh). 앱이 환경 변수를 .env 보다 먼저 읽는다
EnvironmentFile=/etc/sbrain/db.env
EnvironmentFile=/etc/sbrain/notice.env
Environment=PORT=8000
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# BGE-M3 는 설치할 때 받아 둔다(계정 홈 ~/.cache/huggingface). 켤 때 인터넷에 묻지 않는다
Environment=HF_HUB_OFFLINE=1
WorkingDirectory=/opt/sbrain-notice/current/data-collection
ExecStart=/opt/sbrain-notice/current/.venv/bin/python -X utf8 -m search.app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

# MySQL/MariaDB 접속 정보 (파이프라인과 DB를 공유하므로 값은 동일해야 함)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 구글 로그인 / 세션 JWT (백엔드 전용, 파이프라인 쪽 .env엔 불필요)
GOOGLE_CLIENT_ID=
JWT_SECRET=

# 공공데이터포털 - 국세청 사업자등록정보 진위확인 및 상태조회 서비스
# 마이페이지 > 데이터활용 > Open API > 활용신청현황에서 "디코딩" 키를 넣을 것
# (인코딩 키를 넣으면 requests가 다시 인코딩해서 이중 인코딩 에러가 남)
NTS_SERVICE_KEY=
# 산출물 파일 저장소(SB-311) — 로컬 폴더의 절대 경로 또는 S3 주소 s3://<버킷>/<접두어>(예: s3://<버킷>/app/artifacts/, 스킴은 소문자만).
# 워커와 웹이 같은 값을 봐야 한다(같은 폴더, 또는 같은 버킷 · 접두어). 웹은 읽기만 한다(쓰기 · 삭제는 워커).
# 비우거나 상대 경로 · 형식이 틀리면 웹은 뜨지만 산출물 파일 내려받기만 503이 된다. 워커는 이 값이 없으면 시작하지 않는다.
SBRAIN_ARTIFACT_ROOT=
# S3 리전 — SBRAIN_ARTIFACT_ROOT가 s3://일 때 필수(예: ap-northeast-2). 비우면 AWS_DEFAULT_REGION을 읽고, 둘 다 없으면 파일 내려받기만 503.
#   - 버킷이 있는 리전과 같게 넣는다(달라도 확인이 통과할 수 있어 코드가 잡아 주지 않는다). 로컬 폴더 값이면 읽지 않는다.
#   - AWS 키(AWS_ACCESS_KEY_ID · AWS_SECRET_ACCESS_KEY 등)는 이 파일에 넣지 않는다 — 이 파일의 값은 config.py가 프로세스
#     환경 변수로 옮기므로, 넣으면 AWS 라이브러리가 그 키를 쓴다. 자격 증명은 서버 IAM 역할(AWS 기본 순서)로 받는다.
AWS_REGION=

# 로그인 쿠키의 Secure 표시 — 비우면 켜짐(배포 · HTTPS). http로 띄우는 로컬 개발에서 localhost가 아닌 주소로 열 때만 0으로 끈다.
COOKIE_SECURE=

# 사업비 · 추진 일정 필수 입력(SB-332) — 1(또는 true)이면 사업비 1건 이상, 예비창업은 1단계 · 2단계 각 1건 이상, 협약기간 내 일정 1건 이상이
# 없는 프로젝트 생성을 E-C1-REQUIRED로 막는다. 입력 화면이 배포되기 전에 켜면 모든 계획서 작성이 막히므로 화면 배포 뒤에 켠다.
# 오케스트레이터의 필수 확인 스위치도 같은 시점에 켠다. 비우면 꺼진다.
REQUIRE_BUDGET_SCHEDULE=

# HWP 변환 CLI 명령 한 번의 실행 제한(초). Agent 호출 정책과 별개.
# 기본 120초. 양의 정수이며 실제 변환시간과 프록시 제한에 맞춰 조정합니다.
RHWP_TIMEOUT_SECONDS=120

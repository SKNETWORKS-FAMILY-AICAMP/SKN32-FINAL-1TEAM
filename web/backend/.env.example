# MySQL/MariaDB 접속 정보 (파이프라인과 DB를 공유하므로 값은 동일해야 함)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 구글 로그인 / 세션 JWT (백엔드 전용, 파이프라인 쪽 .env엔 불필요)
GOOGLE_CLIENT_ID=
JWT_SECRET=

# 공공데이터포털 - 국세청 사업자등록정보 진위확인 및 상태조회 서비스
# 마이페이지 > 데이터활용 > Open API > 활용신청현황에서 "디코딩" 키를 넣을 것
# (인코딩 키를 넣으면 requests가 다시 인코딩해서 이중 인코딩 에러가 남)
NTS_SERVICE_KEY=
# 산출물 파일(프로토타입 · 인포그래픽) 저장 폴더 — 워커(구현 Agent)와 웹이 같은 폴더를 봐야 한다.
# 절대 경로로 쓰고, 워커를 조립할 때 넘기는 값과 똑같이 맞출 것. 비우면 web/backend/uploads/artifacts.
# 구조: <ARTIFACT_DIR>/<project_id>/<시도 ID>/{index.html | infographic.svg | onepage.svg}
ARTIFACT_DIR=

# 사업비 · 추진 일정 필수 입력(SB-332) — 1(또는 true)이면 사업비 1건 이상, 예비창업은 1단계 · 2단계 각 1건 이상, 협약기간 내 일정 1건 이상이
# 없는 프로젝트 생성을 E-C1-REQUIRED로 막는다. 입력 화면이 배포되기 전에 켜면 모든 계획서 작성이 막히므로 화면 배포 뒤에 켠다.
# 오케스트레이터의 필수 확인 스위치도 같은 시점에 켠다. 비우면 꺼진다.
REQUIRE_BUDGET_SCHEDULE=

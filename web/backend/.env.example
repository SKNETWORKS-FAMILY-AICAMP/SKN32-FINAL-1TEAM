# MySQL/MariaDB 접속 정보 (파이프라인과 DB를 공유하므로 값은 동일해야 함)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 구글 로그인 / 세션 JWT (백엔드 전용, 파이프라인 쪽 .env엔 불필요)
GOOGLE_CLIENT_ID=
JWT_SECRET=

# 공공데이터포털 - 국세청 사업자등록정보 진위확인 및 상태조회 서비스
# 마이페이지 > 데이터활용 > Open API > 활용신청현황에서 "디코딩" 키를 넣을 것
# (인코딩 키를 넣으면 requests가 다시 인코딩해서 이중 인코딩 에러가 남)
NTS_SERVICE_KEY=
# 산출물 파일 저장소 폴더(SB-311) — 워커와 웹이 같은 폴더를 같은 절대 경로로 봐야 한다. 웹은 읽기만 한다(쓰기 · 삭제는 워커).
# 비우거나 상대 경로면 웹은 뜨지만 산출물 파일 내려받기만 503이 된다. 워커는 이 값이 없으면 시작하지 않는다.
SBRAIN_ARTIFACT_ROOT=

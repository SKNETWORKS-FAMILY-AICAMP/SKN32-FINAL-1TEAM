# 이 파일을 .env 로 복사해 값을 채운다:  cp .env.example .env
# .env 는 Git 에 올라가지 않는다(deploy/.gitignore). 값에 $ 가 있으면 작은따옴표로 감싼다.

# ── 주소 ──────────────────────────────────────────────
# 비워 두면 http://서버주소 (80번, HTTP만). 도메인을 넣으면 Caddy 가 HTTPS 인증서를 자동으로 받는다.
#   예) SITE_ADDRESS=sbrain.example.com
# 도메인의 A 레코드가 이 서버 IP 를 가리키고, 보안그룹에서 80·443 이 열려 있어야 한다.
SITE_ADDRESS=

# ── 화면 빌드 값 (바꾸면 docker compose build web 다시) ─────────
# 구글 로그인 클라이언트 ID. 구글 콘솔의 "승인된 JavaScript 원본"에 https://<SITE_ADDRESS> 를 등록해야 로그인된다.
VITE_GOOGLE_CLIENT_ID=

# ── 백엔드 (web/backend/.env.example 과 같은 항목) ──────────────
# 팀 공용 MySQL. 공고 수집 파이프라인과 같은 DB 를 쓴다.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 구글 로그인 검증용(화면의 VITE_GOOGLE_CLIENT_ID 와 같은 값)과 세션 서명 키.
GOOGLE_CLIENT_ID=
# 아무 긴 임의 문자열. 만들기:  openssl rand -hex 32
JWT_SECRET=

# 국세청 사업자등록 상태조회(공공데이터포털) — "디코딩" 키. 없으면 마이페이지 자동 판정만 안 된다.
NTS_SERVICE_KEY=

# 이 파일을 .env 로 복사해 값을 채운다. .env 는 절대 커밋하지 않는다.
#
#   copy .env.example .env          (cmd)
#   Copy-Item .env.example .env     (PowerShell)

# ── K-Startup (공공데이터포털) ────────────────────────────
# data.go.kr 마이페이지의 **일반 인증키(Decoding)** 값을 넣는다.
# Encoding 값(%2B, %2F, %3D 가 들어간 것)을 넣으면 이중 인코딩으로 인증에 실패한다.
KSTARTUP_KEY=

# ── 기업마당 ────────────────────────────────────────────
# 기업마당이 자체 발급하는 crtfcKey. 위 키와 다른 값이다.
BIZINFO_KEY=

# ── MySQL ──────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=s_brain
MYSQL_USER=
MYSQL_PASSWORD=

# ── 원격 DB 로 붙을 때만 ─────────────────────────────────
# 서버가 require_secure_transport=ON 이면 평문 연결을 거부한다.
# CA 인증서로 서버 신원까지 검증한다. 파일은 data/ec2-ca.pem 에 함께 들어 있다.
#
#   MYSQL_SSL_CA=data/ec2-ca.pem
#
# CA 없이 암호화만 하려면 아래를 대신 쓴다.
#   MYSQL_SSL=1
#
# 둘 다 비우면 평문으로 붙는다(로컬 개발).
MYSQL_SSL_CA=

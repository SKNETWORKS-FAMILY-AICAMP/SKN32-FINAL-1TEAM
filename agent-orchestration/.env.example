# S-Brain Orchestrator 환경 변수 — 이 파일을 같은 폴더에 .env로 복사해 값을 채운다.
# - .env는 Git · 저장소 사본에 올리지 않는다(비밀 값). 이 예시 파일에는 값을 적지 않는다.
# - 이미 설정된 환경 변수가 .env보다 우선한다. 빈 값(KEY=)은 설정하지 않은 것으로 본다.
# - 값은 적힌 그대로 읽는다(${VAR} 치환 없음). 공백이나 #이 들어가면 따옴표로 감싼다.

# OpenAI API 키 — 조율 Agent의 OpenAI 호출처(sbrain/orchestrator/openai_provider.py). 워커 필수
OPENAI_API_KEY=

# 공유 MySQL 접속 URL — 워커(python -m sbrain.worker)와 웹 조립(build_web) 필수
#   형식: mysql+pymysql://사용자:비밀번호@호스트:3306/DB이름?charset=utf8mb4
SBRAIN_DB_URL=

# 공고 서버 주소 (선택) — 공고팀 공고 서버(HTTP API)의 기본 주소. 형식: http://호스트:포트
#   - 넣으면 워커가 공고 매칭(T-C2) · 자격 확인(G-01)을 공고 서버로 한다(실제 모드). 비우면 스텁이 돈다(스텁 모드).
#   - 공고팀의 네 API(수집 상태 · 공고 추천 · 공고 상세 · 자격 판정)를 확인한 뒤에만 넣는다.
#   - 운영 공고 서버는 내부망에 두고 워커만 접근하게 한다. 공개된 시험 서버에는 가짜 신청 정보로만 연결한다.
#   - 워커는 1대로 운영한다(호출을 하나씩 보낸다 — 공고팀이 동시 호출 안전성을 확인하기 전까지).
#   - 실제 주소는 비밀 값처럼 다룬다. 이 예시 파일 · 문서 · 로그에 적지 않는다.
SBRAIN_NOTICE_API_URL=

# 실행별 KIET 시장 자료 검색 (선택, 기본 꺼짐) — 1 · true · yes · on(대소문자 · 앞뒤 공백 무시)이면 켠다. 그 밖의 값 · 빈 값은 꺼짐
#   - 켜면 워커의 T-S1이 실행마다 F01 전에 KIET(www.kiet.re.kr)를 검색해 그 실행의 시장 근거에만 더한다(서버 파일에 쌓지 않음).
#   - KIET로 나가는 값은 기술 분야(비면 아이디어 설명 앞 120자)뿐이다. 실패하면 있는 자료로 계속한다(실행은 멈추지 않음).
#   - 운영 워커에만 넣는다(개발 PC · 시험에서 모르고 외부로 나가지 않게). 웹 프로세스는 T-S1을 돌리지 않아 상관없다.
#   - 워커를 조립할 때 한 번 읽는다 — 바꾸면 워커를 다시 띄운다. 테스트는 이 값을 늘 없는 것으로 본다.
SBRAIN_KIET_SEARCH=

# 산출물 파일 저장소 — 둘 중 하나. 기본값 없음
#   - 로컬 폴더의 절대 경로(예: Windows D:\sbrain\artifacts, Linux /srv/sbrain/artifacts). 폴더가 없으면 워커가 만든다.
#   - S3: s3://<버킷> 또는 s3://<버킷>/<접두어>(예: s3://<버킷>/app/artifacts/ — 스킴은 소문자 s3://만, 대문자 S3://는 상대 경로로 본다).
#     S3면 아래 AWS_REGION이 필요하고, 워커가 시작할 때 시험 객체로 읽기 · 쓰기 · 지우기를 한 번 확인한다.
#   - 워커 필수: 없음 · 상대 경로 · S3 주소 형식 오류 · S3인데 리전 없음이면 워커가 시작하지 않는다(종료 코드 2).
#   - 웹 조립(build_web) 선택: 쓸 수 있는 값이면 읽기 전용으로 연다(쓰지도 지우지도 않음). 아니면 파일 읽기만 FILE_STORE_UNAVAILABLE.
#   - 웹과 모든 워커가 같은 값을 봐야 한다(같은 폴더, 또는 같은 버킷 · 같은 접두어).
#   - 실제 버킷 이름은 이 예시 파일 · 문서 · 로그에 적지 않는다.
SBRAIN_ARTIFACT_ROOT=

# S3 리전 — SBRAIN_ARTIFACT_ROOT가 s3://일 때 필수(예: ap-northeast-2). 비우면 AWS_DEFAULT_REGION을 읽는다.
#   - 버킷이 있는 리전과 같게 넣는다(달라도 확인이 통과할 수 있어 코드가 잡아 주지 않는다). 로컬 폴더 값이면 읽지 않는다.
#   - AWS 키(AWS_ACCESS_KEY_ID · AWS_SECRET_ACCESS_KEY 등)는 이 파일에 넣지 않는다 — 자격 증명은 AWS 기본 순서(EC2에서는 서버
#     IAM 역할)로 AWS 라이브러리가 찾는다. 우리 코드는 AWS 키를 읽지 않고, AWS 라이브러리는 이 .env를 읽지 않는다.
AWS_REGION=

# 워커 설정 (선택, 비우면 잠정 기본값) — 할 일이 없을 때 쉬는 초 · 스레드 수 · 점유 시간(초)
SBRAIN_WORKER_POLL_SEC=
SBRAIN_WORKER_THREADS=
SBRAIN_WORKER_LEASE_SEC=

# 워커 운영 로그 파일 (선택)
#   - SBRAIN_WORKER_LOG_DIR: 로그 폴더. 넣으면 화면과 같은 줄을 그 폴더의 UTC 날짜 파일(YYYY-MM-DD.log, 20MB를 넘으면
#     YYYY-MM-DD.1.log …)에도 쓴다. 비우면 화면에만 쓴다. 없으면 만든다. 워커마다 폴더를 따로 쓴다(worker.lock).
#   - SBRAIN_WORKER_LOG_KEEP_DAYS: 양의 정수 N이면 이름의 날짜가 N일 넘게 지난 로그 파일을 지운다. 비우면 지우지 않는다.
#     운영에서는 366 이하로 켜기를 권장한다(실행 로그 12개월 보관 규칙).
SBRAIN_WORKER_LOG_DIR=
SBRAIN_WORKER_LOG_KEEP_DAYS=

# MySQL 8 통합 테스트용 로컬 DB (docker/mysql-test.yml). 비워 두면 MySQL 테스트는 건너뛴다.
# 테스트가 이 DB의 테이블을 모두 지우고 새로 만든다 — 로컬 DB(127.0.0.1 · localhost, 이름에 test)만 받는다.
# 공유 DB 주소를 넣지 않는다. docker/mysql-test.yml을 띄웠다면 아래 값을 그대로 쓰면 된다(테스트용 비밀번호).
#   SBRAIN_TEST_MYSQL_URL=mysql+pymysql://root:sbrain-test@127.0.0.1:3307/sbrain_test?charset=utf8mb4
SBRAIN_TEST_MYSQL_URL=

# MySQL 통합 테스트가 읽는 웹 스키마(app_schema.sql) 경로 (선택). 비우면 이 폴더 한 단계 위의
# web/backend/app_schema.sql을 찾는다(웹과 같은 저장소에 둔 배치).
SBRAIN_TEST_WEB_SCHEMA=
